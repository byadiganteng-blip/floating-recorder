<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎙️ Floating Recorder"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp"/>
        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:fontFamily="monospace"/>
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Status: Idle"
            android:textColor="@color/accent_green"
            android:textSize="13sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amplify (volume boost):"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:paddingTop="12dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <SeekBar
                android:id="@+id/sbAmplify"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="@color/accent_green"/>
            <TextView
                android:id="@+id/tvAmplifyValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="3.0x"
                android:textColor="@color/accent_green"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="end"/>
        </LinearLayout>
        <Spinner
            android:id="@+id/spMode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/card_bg"
            android:layout_marginTop="8dp"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="▶️  Aktifkan Floating Recorder"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/accent_green"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="⏹️  Stop"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/accent"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOpen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="📁  Buka Folder Rekaman"
            android:textColor="@color/text"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="📋  Lihat Log"
            android:textColor="@color/text"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\n💡 Cara pakai:\n1. Tap 'Aktifkan Floating Recorder'\n2. Izinkan overlay + mic\n3. Button merah muncul di layar\n4. Buka app lain (YouTube, Spotify)\n5. Tap button → mulai rekam\n6. Tap lagi → stop\n7. File: Downloads/FloatingRecorder/"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:paddingTop="16dp"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>
</ScrollView>
