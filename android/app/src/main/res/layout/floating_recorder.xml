<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@drawable/floating_bg"
    android:padding="10dp" android:gravity="center_vertical">
    <View android:id="@+id/statusDot" android:layout_width="12dp" android:layout_height="12dp"
        android:background="@drawable/dot_green"/>
    <TextView android:id="@+id/tvTime" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:text="00:00" android:textColor="@color/text" android:textSize="14sp"
        android:textStyle="bold" android:fontFamily="monospace"/>
    <TextView android:id="@+id/tvLabel" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp" android:text="Idle" android:textColor="@color/text_dim"
        android:textSize="11sp"/>
</LinearLayout>
